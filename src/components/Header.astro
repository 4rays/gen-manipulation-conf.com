---
import {ArrowUpRight} from "@lucide/astro";
import {contactMailto, getConference} from "@/data/conference";
import type {Locale} from "@/i18n/constants";
import {locales} from "@/i18n/constants";
import {localizeUrl, useTranslations} from "@/i18n/utils";
import LanguagePicker from "@/components/LanguagePicker.astro";

interface Props {
  locale: Locale;
  localized?: boolean;
}

const {locale, localized = true} = Astro.props;
const conference = getConference(locale);
const t = useTranslations(locale).conference;
const home = localizeUrl("/", locale);
---

<header class="site-header surface-plaster" data-site-header>
  <div class="layout-container site-header__inner">
    <a class="site-wordmark" href={home}>
      {conference.title}
    </a>
    <button
      class="site-menu-toggle"
      type="button"
      hidden
      aria-expanded="false"
      aria-controls="site-navigation"
      data-menu-toggle
    >
      {t.menu}
    </button>
    <nav id="site-navigation" class="site-navigation" aria-label={t.navigation}>
      {conference.navigation.map((item) => (
        <a href={`${home}${item.href}`} data-section-link>
          {item.label}
        </a>
      ))}
      <a
        class="site-navigation__contact"
        href={contactMailto(conference.contacts)}
      >
        {t.contact}
        <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" />
      </a>
      {localized && locales.length > 1 && <LanguagePicker locale={locale} />}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const navigation = header?.querySelector<HTMLElement>("#site-navigation");

  if (header && toggle && navigation) {
    const compact = window.matchMedia("(max-width: 47.999rem)");
    header.dataset.enhanced = "";

    const setExpanded = (expanded: boolean) => {
      toggle.setAttribute("aria-expanded", String(expanded));
      navigation.hidden = compact.matches && !expanded;
    };

    const syncViewport = () => {
      toggle.hidden = !compact.matches;
      setExpanded(false);
    };

    toggle.addEventListener("click", () => {
      setExpanded(toggle.getAttribute("aria-expanded") !== "true");
    });

    header.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        setExpanded(false);
        toggle.focus();
      }
    });

    navigation.addEventListener("click", (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>("a");
      if (!link || !compact.matches) return;
      // A fragment target receives focus when a compact menu closes, so
      // keyboard focus does not remain inside the now-hidden panel.
      const target = document.getElementById(new URL(link.href).hash.slice(1));
      setExpanded(false);
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.focus({preventScroll: true});
      } else {
        toggle.focus();
      }
    });

    compact.addEventListener("change", syncViewport);
    syncViewport();

    const syncScroll = () =>
      header.toggleAttribute("data-scrolled", window.scrollY > 8);
    window.addEventListener("scroll", syncScroll, {passive: true});
    syncScroll();

    if ("IntersectionObserver" in window) {
      const links = [
        ...navigation.querySelectorAll<HTMLAnchorElement>("[data-section-link]")
      ];
      const sections = links
        .map((link) =>
          document.getElementById(new URL(link.href).hash.slice(1))
        )
        .filter((section): section is HTMLElement => section !== null);
      const visible = new Set<string>();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target.id);
            else visible.delete(entry.target.id);
          }
          const active = sections.find((section) => visible.has(section.id));
          for (const link of links) {
            if (active && new URL(link.href).hash === `#${active.id}`)
              link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
          }
        },
        {rootMargin: "-40% 0px -55% 0px"}
      );
      sections.forEach((section) => observer.observe(section));
    }
  }
</script>
