---
import {ArrowUpRight, Plus} from "@lucide/astro";
import type {Speaker} from "@/data/conference";
import type {Translations} from "@/i18n/constants";

interface Props {
  speakers: Speaker[];
  labels: Translations["conference"];
  /** Section id and heading; the organisers section reuses this layout. */
  id?: string;
  heading?: string;
}

const {
  speakers,
  labels,
  id = "speakers",
  heading = labels.speakers
} = Astro.props;
---

<section
  id={id}
  class="conference-section conference-speakers surface-shade"
  aria-labelledby={`${id}-heading`}
>
  <div class="layout-container">
    <h2 id={`${id}-heading`}>{heading}</h2>
    <div class="speaker-list">
      {speakers.map((speaker) => (
        <article
          id={`speaker-${speaker.id}`}
          class="speaker"
          aria-labelledby={`speaker-name-${speaker.id}`}
        >
          <div class="speaker__identity">
            {speaker.portrait && (
              <img
                class="speaker__avatar"
                src={speaker.portrait}
                alt=""
                width="240"
                height="240"
                loading="lazy"
                decoding="async"
              />
            )}
            <div>
              <h3 id={`speaker-name-${speaker.id}`}>{speaker.name}</h3>
              <p class="speaker__role">{speaker.role}</p>
              {speaker.institution && (
                <p class="speaker__institution">{speaker.institution}</p>
              )}
            </div>
          </div>
          <div class="speaker__description">
            <p>{speaker.shortBio}</p>
            <details>
              <summary>
                {labels.readBiography}
                <span class="sr-only"> — {speaker.name}</span>
                <Plus size={18} stroke-width={1.5} aria-hidden="true" />
              </summary>
              <div class="speaker__biography">
                {speaker.fullBio.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {speaker.profileUrl && (
                  <a href={speaker.profileUrl}>
                    {speaker.profileLabel ?? labels.speakerProfile}
                    <ArrowUpRight
                      size={16}
                      stroke-width={1.5}
                      aria-hidden="true"
                    />
                  </a>
                )}
              </div>
            </details>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
