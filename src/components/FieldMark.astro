---
// The Field mark: a round window onto the Pull Field. Strands and ring use
// currentColor, so the mark takes the text colour of its surface. The path
// data is generated by scripts/generate-mark.ts.
import {markPaths} from "@/data/mark";

interface Props {
  /** 7 strands for large sizes, 5 for 40px and below. */
  strands?: 7 | 5;
  class?: string;
}

const {strands = 5, class: className} = Astro.props;
---

<svg
  class:list={["field-mark", className]}
  viewBox="0 0 100 100"
  aria-hidden="true"
  focusable="false"
>
  <circle class="field-mark__ring" cx="50" cy="50" r="48.5"></circle>
  <path class="field-mark__strands" d={markPaths[strands]}></path>
</svg>
