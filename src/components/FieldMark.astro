---
// The Field mark: three strands wound into one spiral around a point that is
// never drawn. The strands use currentColor, so the mark takes the text
// colour of its surface. The path data is generated by
// scripts/generate-mark.ts.
import {markPaths} from "@/data/mark";

interface Props {
  /** Fewer turns for 40px and below. */
  size?: "large" | "small";
  class?: string;
}

const {size = "small", class: className} = Astro.props;
---

<svg
  class:list={["field-mark", className]}
  viewBox="0 0 100 100"
  aria-hidden="true"
  focusable="false"
>
  <path class="field-mark__strands" d={markPaths[size]}></path>
</svg>
